@model SliderEditModel
@{
    Layout = "_AdminLayout";
}

<div class="row">
  <div class="col">
    <div class="card shadow">
      <div class="card-header py-1 d-flex justify-content-between align-items-center">
        <h5 class="card-title">Slider Güncelle</h5>
        <a asp-controller="Slider" asp-action="Index" class="btn btn-sm btn-primary">
          <i class="fa-solid fa-list"></i>
        </a>
      </div>
      <div class="card-body">

        <form method="post" asp-controller="Slider" asp-action="Edit" enctype="multipart/form-data">
          <div asp-validation-summary="All" class="text-danger"></div>

            <input type="hidden" asp-for="ResimAdi" />
            <input type="hidden" asp-for="Id" />

            <div class="row mb-3">
                <label class="col-sm-2 col-form-label"> Mevcut Resim </label>
                <div class="col-sm-10">
                    <img src="~/img/@Model.ResimAdi" class="img-fluid rounded">
                </div>
            </div>
          
          <div class="row mb-3">
            <label asp-for="Baslik" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
              <input asp-for="Baslik" class="form-control">
              <span asp-validation-for="Baslik" class="text-danger"></span>
            </div>
          </div>

          <div class="row mb-3">
            <label asp-for="Aciklama" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
              <textarea asp-for="Aciklama" rows="3" class="form-control"></textarea>
            </div>
          </div>

          <div class="row mb-3">
            <label asp-for="Resim" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
              <input asp-for="Resim" class="form-control"></input>
              <span asp-validation-for="Resim" class="text-danger"></span>
            </div>
          </div>

          <div class="row mb-3">
            <label asp-for="Index" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
              <input asp-for="Index" class="form-control">
              <span asp-validation-for="Index" class="text-danger"></span>
            </div>
          </div>

          <div class="row mb-3">
            <label asp-for="Aktif" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
              <input asp-for="Aktif" class="form-check-input" checked/>
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-sm-10 offset-2">
              <button class="btn btn-primary" type="submit">Kaydet</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

@section Scripts{
    @await Html.PartialAsync("_ValidationScriptsPartial")
}