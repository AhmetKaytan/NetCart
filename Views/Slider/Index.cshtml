@model List<SliderGetModel>
@{
  Layout= "_AdminLayout";
}


<div class="row">
  <div class="col">
    <div class="card shadow">
      <div
        class="card-header py-1 d-flex justify-content-between align-items-center"
      >
        <h5 class="card-title">Sliderlar</h5>
        <a asp-controller="Slider" asp-action="Create" class="btn btn-sm btn-primary">
          <i class="fa-solid fa-plus"></i>
        </a>
      </div>
      <div class="card-body">
        @if(Model.Count==0){
          <p>Slider Bulunamadı...</p>
        }
        else{
          <div class="table-responsive">
            <table
              class="table table-bordered table-hover table-striped mb-0"
            >
              <thead class="table-secondary">
                <tr>
                  <th style="width: 20px">ID</th>
                  <th style="width: 200px">Resim</th>
                  <th>Başlık</th>
                  <th>Aktiflik</th>
                  <th>Index</th>
                  <th style="width: 95px"></th>
                </tr>
              </thead>
              <tbody>
                @foreach(SliderGetModel s in Model){

                  <tr>
                    <td>@s.Id</td>
                    <td>
                      <img src="~/img/@s.Resim" class="img-fluid" alt="" />
                    </td>
                    <td>@s.Baslik</td>
                    <td>
                      @if(s.Aktif){
                        <i class="fa-solid fa-circle-check text-success"></i>
                      }
                      else{
                        <i class="fa-solid fa-circle-xmark text-danger"></i>
                      }
                    </td>
                    <td>@s.Index</td>
                    <td>
                      <a asp-controller="Slider" asp-action="Edit" asp-route-id="@s.Id" class="btn btn-primary btn-sm">
                        <i class="fa-solid fa-pen-to-square"></i>
                      </a>

                      <a asp-controller="Slider" asp-action="Delete" asp-route-id="@s.Id" class="btn btn-danger btn-sm">
                        <i class="fa-solid fa-trash "></i>
                      </a>
                    </td>
                  </tr>
                }
                
              </tbody>
            </table>
          </div>
        }
      </div>
    </div>
  </div>
</div>




